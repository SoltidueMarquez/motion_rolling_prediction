    "version": "0.2.0",
    "configurations": [
        {
            "name": "RPM: Prepare AMASS P1 Full (CPU Resume)",
            "type": "debugpy",
            "request": "launch",
            "python": "D:\\Programme\\Python\\Anaconda3lenvs\\rpm\\python.exe",
            "program": "${workspaceFolder}\\prepare_data.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false,
            "args": [
                "--save_dir",
                "${workspaceFolder}\\datasets_processed\\amass_p1\\new_format_data",
                "--root_dir",
                "${workspaceFolder}\\datasets_raw\\amass_p1",
                "--splits_dir",
                "${workspaceFolder}\\prepare_data\\amass_p1",
                "--support_dir",
                "${workspaceFolder}\\SMPL",
                "--out_fps",
                "60",
                "--cpu"
            ]
        },
        {
            "name": "RPM: Official A-P1 Reactive Inference Smoke (MC, 1 Sample)",
