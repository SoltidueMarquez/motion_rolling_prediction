            "request": "launch",
            "python": "D:\\Programme\\Python\\Anaconda3lenvs\\rpm\\python.exe",
            "program": "${workspaceFolder}\\test.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {
                "PYTHONDONTWRITEBYTECODE": "1"
            },
            "args": [
                "--model_path",
                "${workspaceFolder}\\checkpoints\\amass_p1\\reactive\\model_latest.pt",
